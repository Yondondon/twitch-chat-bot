# Twitch application credentials (from the Twitch Developer Console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Broadcaster account — used to subscribe to channel.chat.message via
# EventSub, to send chat replies, and (for the dashboard) to check whether a
# signed-in visitor is a moderator. No separate bot account is used.
# Requires a user access token scoped: user:read:chat user:write:chat moderation:read
BROADCASTER_USER_ID=
BROADCASTER_ACCESS_TOKEN=
BROADCASTER_REFRESH_TOKEN=

# Optional: path to the SQLite database file (defaults to ./data/bot.sqlite)
DATABASE_PATH=./data/bot.sqlite

# HTTP API (dashboard backend) — see specs/002-commands-ui/research.md §3
# Must exactly match a redirect URI registered on the Twitch app above.
TWITCH_REDIRECT_URI=
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Origin the UI dev/prod server is served from — used for CORS + post-login redirect
UI_ORIGIN=
# Port the HTTP API listens on
HTTP_PORT=
