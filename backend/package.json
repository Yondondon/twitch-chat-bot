{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Single-channel Twitch bot for custom chat commands, plus its HTTP API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/storage/migrations && cp src/storage/migrations/*.sql dist/storage/migrations/",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start:server": "node --env-file=.env dist/server-entry.js",
    "dev:server": "tsx watch --env-file=.env src/server-entry.ts",
    "dev:bot": "tsx watch --env-file=.env src/index.ts",
    "migrate": "pnpm run build && node dist/storage/migrate.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@twurple/api": "^7.2.1",
    "@twurple/auth": "^7.2.1",
    "@twurple/eventsub-ws": "^7.2.1",
    "fastify": "^5.12.0",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.13.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^2.1.4"
  }
}
