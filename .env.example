# Twitch application credentials (from the Twitch Developer Console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Broadcaster account — used both to subscribe to channel.chat.message via
# EventSub and to send chat replies. No separate bot account is used.
# Requires a user access token scoped: user:read:chat user:write:chat
BROADCASTER_USER_ID=
BROADCASTER_ACCESS_TOKEN=
BROADCASTER_REFRESH_TOKEN=

# Optional: path to the SQLite database file (defaults to ./data/bot.sqlite)
DATABASE_PATH=./data/bot.sqlite
